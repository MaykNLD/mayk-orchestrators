# Variables de Entorno — mayk-orchestrators
# ─────────────────────────────────────────────────────────────────
# IMPORTANTE: Este archivo es SOLO documentación de referencia.
# Los valores REALES se gestionan exclusivamente como GitHub Secrets.
# Nunca rellenes este archivo con valores reales y nunca hagas commit de .env
#
# Cómo usar en local (desarrollo únicamente):
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores en .env
#   3. .env está en .gitignore — nunca se sube al repo
# ─────────────────────────────────────────────────────────────────

# ── OpenRouter (Enrutamiento de IAs) ─────────────────────────────
# Proveedor: https://openrouter.ai
# Gestiona: Gemini Flash, Claude Haiku, GPT-4o-mini, Claude Sonnet
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (Base de datos) ──────────────────────────────────────
# Proveedor: https://supabase.com
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Make.com (Automatización — 1000 créditos/mes) ─────────────────
# Estrategia: 1 sola llamada al finalizar proyecto completo (batch)
# Proveedor: https://make.com
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxx

# ── Tailscale (Red privada segura) ────────────────────────────────
# AuthKey para conectar GitHub Actions a la red Tailscale
# Generar en: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxx

# ── Configuración general ─────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────
# En producción: NINGUNA de estas variables existe en el servidor.
# Todas se inyectan dinámicamente desde GitHub Secrets en el CI/CD.
# ─────────────────────────────────────────────────────────────────
