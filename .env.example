# Variables de Entorno — mayk-orchestrators
# ─────────────────────────────────────────────────────────────────
# Este archivo es un EJEMPLO. No contiene valores reales.
# Los valores reales van a GitHub Secrets del repo (nunca aquí).
#
# Cómo configurar:
#   1. Copia este archivo como .env en tu entorno local
#   2. Rellena los valores reales
#   3. NUNCA hagas commit del .env con valores reales
#   4. En producción / CI: configura cada variable en GitHub Secrets
# ─────────────────────────────────────────────────────────────────

# ── APIs de Modelos de IA (a futuro — sin keys por ahora) ────────
# Cuando se implementen llamadas automáticas desde el orquestador:

# Google Gemini (para Agente Auditor y Agente QA-Ops)
GEMINI_API_KEY=

# OpenAI / GPT (para Agente Visual)
OPENAI_API_KEY=

# Anthropic / Claude (para Agente Estratega y Agente Dev)
ANTHROPIC_API_KEY=

# ── Configuración general ─────────────────────────────────────────
# Entorno de ejecución
NODE_ENV=development

# ── Integraciones opcionales (según proyecto) ─────────────────────
# Si el orquestador necesita conectarse a servicios externos a futuro:

# GitHub (para automatizar creación de repos privados)
GITHUB_TOKEN=
GITHUB_ORG=

# Notificaciones (Slack, email, etc.)
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────
# RECUERDA: Este archivo (.env.example) SÍ va al repo.
#            El archivo .env con valores reales NUNCA va al repo.
# ─────────────────────────────────────────────────────────────────
